/* Configurações gerais */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f4f7fa;
    color: #183C63;
    line-height: 1.6;
}


/* Cabeçalho */

header {
    background-color: #183C63;
    color: white;
    text-align: center;
    padding: 30px 20px;
}

header h1 {
    font-size: 38px;
    margin-bottom: 5px;
}

header p {
    font-size: 20px;
}

nav {
    margin-top: 20px;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 12px;
    font-weight: bold;
    transition: 0.3s;
}

nav a:hover {
    color: #7fc8ff;
}


/* Conteúdo principal */

main {
    max-width: 1200px;
    margin: auto;
    padding: 20px;
}

section {
    margin-bottom: 40px;
}


/* Área inicial */

.hero {
    min-height: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 20px;
    background-color: white;
    border: 1px solid #183C63;
    border-radius: 8px;
}

.hero h2 {
    font-size: 32px;
    margin-bottom: 15px;
}

.hero p {
    max-width: 700px;
    margin-bottom: 20px;
}


/* Botões */

button {
    background-color: #183C63;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 10px 18px;
    cursor: pointer;
    font-size: 15px;
    transition: 0.3s;
}

button:hover {
    background-color: #245b91;
    transform: translateY(-2px);
}


/* Títulos */

section > h2 {
    text-align: center;
    margin-bottom: 20px;
    font-size: 28px;
}


/* Cards dos artigos */

.articles-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
}

article {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    justify-content: center;
    border: 1px solid #183C63;
    margin: 16px;
    gap: 16px;
    padding: 16px;
    flex: 1 1 25%;
    min-width: 250px;
    background-color: white;
    border-radius: 8px;
    transition: 0.3s;
}

article:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(24, 60, 99, 0.2);
}

article h3 {
    font-size: 21px;
}

article p {
    color: #444;
}


/* Sobre */

.sobre {
    background-color: white;
    border: 1px solid #183C63;
    border-radius: 8px;
    padding: 30px;
    text-align: center;
}

.sobre p {
    max-width: 800px;
    margin: auto;
}


/* Formulário */

.contato {
    background-color: white;
    border: 1px solid #183C63;
    border-radius: 8px;
    padding: 30px;
}

form {
    max-width: 600px;
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

input,
textarea {
    font-family: inherit;
    font-size: 16px;
    padding: 10px;
    border: 1px solid #aaa;
    border-radius: 5px;
}

input:focus,
textarea:focus {
    outline: none;
    border-color: #183C63;
}

#mensagemFormulario {
    text-align: center;
    margin-top: 15px;
    font-weight: bold;
}


/* Rodapé */

footer {
    background-color: #183C63;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 30px;
}


/* Responsividade */

@media (max-width: 768px) {

    header h1 {
        font-size: 30px;
    }

    nav a {
        display: inline-block;
        margin: 5px;
    }

    article {
        flex: 1 1 100%;
        margin: 8px;
    }

    .hero h2 {
        font-size: 26px;
    }

    main {
        padding: 10px;
    }
}
